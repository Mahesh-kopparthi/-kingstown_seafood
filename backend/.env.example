# Database Configuration
# For Render deployment (PostgreSQL):
DATABASE_URL=postgresql://user:password@host:port/database
# For local development with SQLite:
# DATABASE_URL=sqlite:///./kingstown.db
POSTGRES_USER=kingstown
POSTGRES_PASSWORD=kingstown_password
POSTGRES_DB=kingstown_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002

# Environment
ENVIRONMENT=production
DEBUG=false
USE_SQLITE=false
